---
# Copy to group_vars/all.yml and edit for your environment.
# Every knob for both workflows (migration + DR) lives here.

# ── Staging share (MIGRATION MODE / site.yml ONLY) ───────────────────────────
# DR mode (dr_site.yml) needs NO staging storage — it provisions via the
# VergeOS API and replicates over NBD straight into vSAN.
#
# Migration mode stages full disk images on an NFS export reachable by both
# sides, with root-write allowed from the Proxmox nodes.
# Preferred: a VergeOS NAS local volume, so staging lives on vSAN and no
# third-party NAS is involved. One-time setup in VergeOS:
#   1. Deploy the NAS service (NAS section) and note the service's IP.
#   2. Create a local volume (e.g. 'vergeos-staging') on that service.
#   3. Share it over NFS with root access allowed from the Proxmox nodes.
# Any external NFS server also works (add it in VergeOS as a remote volume).
staging_nfs_server: 192.168.1.20
staging_nfs_export: /vergeos-staging
staging_mount: /mnt/vergeos-staging

# ── Export behaviour (migration mode) ────────────────────────────────────────
# live    = QMP drive-mirror while the VM keeps running; cutover downtime is
#           seconds of finalize + the VergeOS import + first boot.
# offline = clean shutdown, then qemu-img convert. Simplest and bomb-proof;
#           downtime additionally includes the full disk copy.
export_mode: live

# qcow2 is native for Proxmox and a supported VergeOS import format.
# Switch to vmdk only if your VergeOS build refuses qcow2 references in the
# generated OVF (see README troubleshooting).
export_format: qcow2

# Throttle each mirror/replication job in bytes/sec (0 = unthrottled).
# Recommended when source storage or the network is shared with production.
mirror_speed_limit: 0

# Freeze guest filesystems via qemu-guest-agent right before pausing at
# cutover/failover (best-effort; VSS-integrated on Windows guests).
fsfreeze_on_cutover: true

# Set onboot=0 on cut-over VMs so a Proxmox reboot can never resurrect a
# machine that now lives on VergeOS (split-brain protection).
disable_onboot_after_cutover: true

# ── VergeOS ──────────────────────────────────────────────────────────────────
vergeos_host: 192.168.1.100
vergeos_username: admin
# Password resolution, first match wins:
#   1. VERGEOS_PASSWORD env var (if exported in the calling shell)
#   2. a mode-600 file holding only the password — create once with:
#        install -m 600 /dev/null ~/.vergeos_pass && vi ~/.vergeos_pass
vergeos_password_file: ~/.vergeos_pass
vergeos_password: >-
  {{ lookup('ansible.builtin.env', 'VERGEOS_PASSWORD')
     or lookup('ansible.builtin.file', vergeos_password_file, errors='ignore')
     or '' }}
vergeos_insecure: true # accept the self-signed UI certificate

# Migration mode: name of the VergeOS NAS volume holding the staged files.
vergeos_nas_volume: vergeos-staging

# Migration mode: post-import spec enforcement and power-on.
fixup_after_import: true
power_on_after_import: false

# Migration mode: how long '-t import' polls for imported VMs to appear
# (retries x delay seconds).
import_wait_retries: 120
import_wait_delay: 30

# ── DR mode (dr_site.yml) ────────────────────────────────────────────────────
# Standby VMs in VergeOS boot a tiny Debian "receiver" that exports their
# blank disks over NBD; Proxmox continuously mirrors into them. Failover is
# an explicit acknowledged action (-t failover -e confirm_failover=yes).

# VergeOS network the standby VMs' NICs attach to. Receivers get their own
# IPs/MACs, so this can safely be a production network — the Proxmox nodes
# just need to reach the receiver IPs (vms.yml dr_ip) on nbd_port.
# "External" is the typical VergeOS name for the LAN-bridged network; verify
# in the UI (Networks section).
dr_network: External
dr_gateway: 192.168.1.1
dr_nameservers: [192.168.1.1]
nbd_port: 10809

# Optional NBD-over-TLS hardening: mutual TLS on all replication
# traffic. Receivers refuse plaintext (force_tls) AND unknown clients
# (client-cert verification); sources verify each receiver's cert
# against its dr_ip. PKI is generated automatically under state/tls/
# (gitignored) and pushed to the Proxmox hosts at -t replicate.
# ⚠️ Flipping this on an already-replicating estate requires
# re-provisioning receivers and restarting mirrors — see README-DR
# "NBD over TLS" for the flip runbook.
dr_nbd_tls: false

# Stock cloud image used as the receiver OS (configured entirely via
# cloud-init; no image baking). The receiver needs outbound internet for one
# package install on first boot — for air-gapped sites, pre-bake the image
# with nbd-server installed and point this at the result.
receiver_image_url: https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2

# Extra GB added to each standby disk beyond the source's virtual size —
# absorbs GB-vs-GiB rounding at the VergeOS API. Keep >= 1. (Replication
# still writes an exactly source-sized image; the slack is never touched.)
dr_disk_slack_gb: 1

# Mirror tuning (optional, applies at the next '-t replicate'):
# dr_mirror_buf_size: 67108864   # 64 MiB mirror buffer — faster initial sync
#                                # (QEMU default is 10 MiB)
# dr_copy_mode: write-blocking   # synchronous replication: guest writes wait
#                                # for the receiver (RPO 0) at the cost of
#                                # write latency. Default: background (~0 RPO)

# Initial-seed optimisation. A sync=full mirror must guarantee that regions
# the source never touches still read zero on the target, so QEMU pre-zeroes
# the whole device before copying. Into a standby disk that -t provision just
# created, that pass is pure waste -- and over NBD to a server without
# WRITE_ZEROES support it becomes a full-disk write of literal zeros.
#
# Requires QEMU >= 10.1 (PVE 9.1 ships 10.1.2); older QEMU ignores it with a
# warning. It is NOT a group_vars setting on purpose -- pass it per run,
# immediately after provisioning, and never again:
#
#     ansible-playbook dr_site.yml -t replicate -e dr_fresh_seed=yes
#
# WARNING: this tells QEMU to ASSUME the target is all-zero. On a re-seed
# over a standby that already holds replicated data it silently corrupts the
# replica. If in doubt, leave it off: the cost is one pre-zeroing pass.
# dr_fresh_seed: false

# First-boot settle cycle (see README-DR): the sacrificial first boot gets
# dr_settle_pause seconds before an automatic power cycle. Disable once your
# platform proves it unnecessary.
dr_first_boot_cycle: true
dr_settle_pause: 45

# ---------------------------------------------------------------------------
# Network translation (tools/netmap.py + tools/netguard.py)
# ---------------------------------------------------------------------------
# Mapping is a policy CHOICE, not a fixed rule. `order` is a chain of
# resolvers tried in sequence; the first to answer wins, and omitting a
# resolver disables it.
#
#   explicit     your own segment -> vnet table below. Always authoritative.
#   alias        match an existing vnet by the source's SDN alias.
#   vlan         match an existing vnet carrying the same VLAN id.
#   name         match an existing vnet by segment / vnet / bridge name.
#   synthesize   create a vnet the source implies. NOT in the default order:
#                creating networks is opt-in.
#
# Segments are (bridge, vlan) pairs -- 'vmbr0', 'vmbr0.20', 'vmbr0:trunk' --
# because two VLANs on one bridge are different layer-2 domains.
net_policy:
  order: [explicit, alias, vlan, name]

  # Pin the ones that matter. Keys may be a segment or a bare bridge; the
  # more specific segment wins.
  explicit: {}
  #   vmbr0.20: prod-web
  #   vmbr0.30: prod-db
  #   vmbr1: dmz

  # What to do with a NIC nothing resolved: refuse | detach | bubble.
  # 'refuse' is the default because a wrongly attached NIC is worse than a
  # stopped migration.
  on_unmapped: refuse

  # Required by on_unmapped=bubble and by attach_mode=bubble. Its isolation
  # is YOUR assertion -- the tooling cannot see the vnet's uplink.
  bubble_network: ""

  synthesize:
    # How good the host topology facts must be before a vnet is invented:
    # any | name-only | host | sdn | authoritative. Proxmox SDN supplies
    # CIDR, gateway and DHCP outright, which earns 'authoritative'; a bare
    # bridge name earns nothing and cannot produce a subnet.
    require_confidence: authoritative
    name_template: "{segment}"   # also {bridge} {vlan} {alias} {vnet}
    network_type: internal       # internal | external | dmz. There is no
                                 # 'vlan' type -- tagging is layer2_type.
    dhcp: inherit                # inherit | on | off
    upstream_gateway: ""         # a vnet's `gateway` is its UPSTREAM router,
                                 # which a source subnet never describes.

# Gate 4. Which attachments are permitted right now, as opposed to which
# are correct. Replication preserves MACs, so attaching a twin while the
# source still runs puts a duplicate MAC and IP on the wire.
#   detached (default)  create NICs, connect them to nothing
#   bubble              force everything onto bubble_network
#   live                attach for real -- only when the source is confirmed
#                       down, or when the VM is named below
net_attach_mode: detached
net_live_attach_running_override: []
